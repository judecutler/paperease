{
  "name": "careloop-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test:photo": "tsx --import ./tests/offline-env.mjs --test tests/photo-check.test.mjs tests/photo-flow.test.cjs",
    "test:all": "tsx --import ./tests/offline-env.mjs --test tests/*.test.*",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "reset": "node -e \"require('fs').rmSync('data/db.json',{force:true})\"",
    "db:seed": "tsx --env-file=.env.local scripts/seed-supabase.ts",
    "test": "tsx --test tests/*.test.ts",
    "regulatory:worker": "tsx scripts/regulatory-worker.ts",
    "regulatory:once": "tsx scripts/regulatory-worker.ts --once",
    "regulatory:check": "tsx scripts/regulatory-check.ts",
    "regulatory:inventory": "tsx scripts/regulatory-inventory.ts",
    "demo": "node scripts/regulatory-demo.mjs",
    "regulatory:live-test": "tsx scripts/regulatory-live-test.ts",
    "regulatory:import": "tsx scripts/regulatory-import.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@supabase/supabase-js": "^2.118.0",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "cheerio": "^1.2.0",
    "pdfjs-dist": "^6.4.299",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "postcss": "^8.5.30"
  }
}
