# Everything is optional. With no keys the demo runs on deterministic extraction and SMS templates.

# Claude: reads uploaded documents, writes SMS copy, interprets replies
ANTHROPIC_API_KEY=
# CARELOOP_MODEL=claude-opus-5-5

# RunAnywhere (OpenAI-compatible): writes follow-up questions only
RUNANYWHERE_BASE_URL=
RUNANYWHERE_API_KEY=
RUNANYWHERE_MODEL=

# Supabase (server only). When both are set the store lives in Supabase instead of data/db.json
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Daily sweep: Vercel Cron sends this as a bearer token to /api/cron. Required in production
CRON_SECRET=

# Where the JSON store and uploads live (default ./data)
# CARELOOP_DATA_DIR=

# California HCA registry check: "demo" (built-in sample registry, default) or "manual" (staff search the CDSS site and record the result)
# REGISTRY_PROVIDER=demo

# Regulatory monitoring uses the same server-only Supabase credentials above.
# Comma-separated Supabase Auth user IDs allowed to activate shared sources
REGULATORY_CURATOR_IDS=
# Optional external scheduler bearer token, at least 32 random characters.
# Not needed when running npm run regulatory:worker continuously.
REGULATORY_CRON_SECRET=
# Conservative daily AI ceilings. Failed requests retain their reservation.
REGULATORY_DAILY_CALL_LIMIT=20
REGULATORY_DAILY_TOKEN_LIMIT=100000
# Explicit isolated local mode, disabled in production. Does not use Supabase.
REGULATORY_LOCAL_DEMO=false
# REGULATORY_DATA_DIR=./data/regulatory

# Compliance gate API for scheduling software (docs/ELIGIBILITY_API.md). "name:secret" pairs, secrets 32+ chars. Off when empty.
ELIGIBILITY_API_KEYS=
# Core app sign-in. "required" gates records, uploads and actions behind a Supabase session (see docs/SECURITY.md). Default: open demo.
# CARELOOP_AUTH=required
